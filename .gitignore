# Proteção adicional na raiz do repositório acadêmico.
# Cada módulo do 2Identify também mantém o próprio .gitignore.

# Ambientes virtuais e caches Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Configuração local e segredos (somente os exemplos são versionados)
.env
.env.*
!.env.example
!.env.mobile.example
device_config.h

# Dados locais, logs e temporários
logs/
*.log
*.db
*.sqlite
*.sqlite3
*.backup
*.tmp

# Modelos de IA não versionados (o checkpoint de EPI é distribuído à parte)
best.pt
best.pt.zip
*.pt

# Sistema operacional e editores
.DS_Store
Thumbs.db
.idea/
.vscode/
